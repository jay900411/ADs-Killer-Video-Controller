{
    "manifest_version": 3,
    "name": "Universal Video & Ad Controller",
    "version": "2.0",
    "description": "通用影片快捷鍵控制器，並搭載特定網站的廣告清除功能。",
    "content_scripts": [
        {
            "matches": [
                "*://anime1.in/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject_anime1.js"
            ],
            "matches": [
                "*://anime1.in/*"
            ]
        }
    ]
}